{
  "expo": {
    "name": "TASKLY",
    "slug": "taskly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskly.app"
    },
    "android": {
      "package": "com.taskly.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "notification": {
        "color": "#315CFF"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "taskly-high-v4",
          "color": "#315CFF",
          "sounds": [
            "./assets/taskly-alarm.wav"
          ]
        }
      ]
    ]
  }
}