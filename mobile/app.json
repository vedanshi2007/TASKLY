{
  "expo": {
    "name": "TASKLY",
    "slug": "taskly",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskly.app"
    },
    "android": {
      "package": "com.taskly.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "notification": {
        "color": "#315CFF"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/taskly-logo.png",
        "backgroundColor": "#FBEAFF"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "taskly-high-v4",
          "color": "#315CFF",
          "sounds": [
            "./assets/taskly_alarm.wav"
          ]
        }
      ],
      "./plugins/withTasklyAlarm"
    ],
    "extra": {
      "eas": {
        "projectId": "2a3bbaf4-2ae0-408a-95e3-d99b4338d0c3"
      }
    },
    "icon": "./assets/taskly-logo.png"
  }
}
